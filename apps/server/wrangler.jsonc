/**
 * enclip の中継サーバー。
 * グループごとの Durable Object が暗号文の保存と配信、ペアリング中のメッセージ受け渡しを持つ。
 * サーバーは内容を読めない（docs/crypto/key-protocol.md）。
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "enclip-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GROUPS",
				"class_name": "GroupObject"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["GroupObject"]
		}
	]
}
